    '39b3fb067d2e96a83a0750dc5e43d168febd79d01352560e06d4d3579d49926e'
    'b460997ad73744df06117200205a0168b91dfef50e7076013a14110abb245a93'
)

prepare() {
    printf '{\n  "package": "%s",\n  "version": "%s",\n  "git_revision": "%s",\n  "working_tree_modified": false,\n  "source_archive_sha256": "%s"\n}\n' \
        "$pkgname" "$epoch:$pkgver-$pkgrel" "$_commit" "${sha256sums[0]}" > "$srcdir/source.json"
    local tree="$srcdir/honk-$_commit"
    printf '%s\n' "$pkgver" > "$tree/SOURCE_VERSION"
    if [[ ! -d $tree/shell/subprojects/gvc ]]; then
        grep -Eq '^revision[[:space:]]*=[[:space:]]*0a4eda0cdc2deb352bebc70ec697c42af46094e4$' "$tree/shell/subprojects/gvc.wrap"
        cp -a "$srcdir/libgnome-volume-control-0a4eda0cdc2deb352bebc70ec697c42af46094e4" "$tree/shell/subprojects/gvc"
    fi
    if [[ ! -d $tree/shell/subprojects/libshew ]]; then
        grep -Eq '^revision[[:space:]]*=[[:space:]]*d16afc40412b565d2bbecf80335f54a19a978009$' "$tree/shell/subprojects/libshew.wrap"
        cp -a "$srcdir/libshew-d16afc40412b565d2bbecf80335f54a19a978009" "$tree/shell/subprojects/libshew"
    fi
    patch -d "$tree/shell/subprojects/libshew" -p1 < "$tree/shell/subprojects/packagefiles/libshew-hwin.patch"
}

build() {
    meson setup build "$srcdir/honk-$_commit/shell" \
        --prefix=/usr --libdir=lib --libexecdir=lib --sysconfdir=/etc \
        --localstatedir=/var --buildtype=release --wrap-mode=nodownload \
        -Db_lto=true -Dwerror=false \
        -Dtests=false -Dcamera_monitor=true -Dnetworkmanager=true -Dportal_helper=true -Dsystemd=true -Dextensions_tool=true
    meson compile -C build -j3
}

package() {
    local component notice
    DESTDIR="$pkgdir" meson install -C build --no-rebuild
    install -Dm644 "$srcdir/source.json" "$pkgdir/usr/share/$pkgname/source.json"
    for component in shell shell/data/theme/honk-shell-sass shell/desktop-icons shell/subprojects/extensions-tool shell/subprojects/gvc shell/subprojects/libshew; do
        for notice in "$srcdir/honk-$_commit/$component"/{COPYING,LICENSE}*; do
            [[ -f $notice ]] || continue
            install -Dm644 "$notice" "$pkgdir/usr/share/licenses/$pkgname/$component/${notice##*/}"
        done
    done
}
