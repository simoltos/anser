+/* Honk's cooperative desktop finishes a drag only after the transfer job. */
+static void
+transfer_result_on_finished (gboolean success,
+                              gpointer callback_data)
+{
+    GDBusMethodInvocation *invocation = callback_data;
+
+    g_dbus_method_invocation_return_value (invocation, g_variant_new ("(b)", success));
+    g_object_unref (invocation);
+    g_application_release (g_application_get_default ());
+}
+
+static gboolean
+handle_transfer_with_result (GDBusMethodInvocation *invocation,
+                              const gchar          **sources,
+                              const gchar           *destination,
+                              GVariant              *platform_data,
+                              gboolean               move)
+{
+    g_autoptr (NautilusFileOperationsDBusData) dbus_data = NULL;
+    g_autolist (GFile) source_files = NULL;
+    g_autoptr (GFile) target_dir = g_file_new_for_uri (destination);
+
+    dbus_data = nautilus_file_operations_dbus_data_new (platform_data);
+    for (guint idx = 0; sources[idx] != NULL; idx++)
+    {
+        source_files = g_list_prepend (source_files, g_file_new_for_uri (sources[idx]));
+    }
+    g_application_hold (g_application_get_default ());
+    nautilus_file_operations_copy_move_with_result (source_files, target_dir, move, dbus_data,
+                                                    transfer_result_on_finished,
+                                                    g_object_ref (invocation));
+    return TRUE;
+}
