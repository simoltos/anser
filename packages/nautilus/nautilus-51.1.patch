+typedef struct
+{
+    GMainLoop *loop;
+    GFile *file;
+    gboolean called;
+    gboolean success;
+} TrashResult;
+
+static void
+trash_result_finished (gboolean success,
+                       gpointer user_data)
+{
+    TrashResult *result = user_data;
+
+    result->called = TRUE;
+    result->success = success;
+    if (result->file != NULL)
+    {
+        /* The result must describe completed filesystem work, not queuing. */
+        g_assert_false (g_file_query_exists (result->file, NULL));
+    }
+    g_main_loop_quit (result->loop);
+}
+
+static void
+test_trash_with_result (void)
+{
+    g_autoptr (GFile) root = NULL;
+    g_autoptr (GFile) directory = NULL;
+    g_autoptr (GFile) file = NULL;
+    g_autolist (GFile) files = NULL;
+    g_autoptr (GMainLoop) loop = g_main_loop_new (NULL, FALSE);
+    TrashResult result = { .loop = loop };
+
+    create_one_file ("trash_result");
+    root = g_file_new_for_path (test_get_tmp_dir ());
+    directory = g_file_get_child (root, "trash_result_first_dir");
+    file = g_file_get_child (directory, "trash_result_first_dir_child");
+    g_assert_true (g_file_query_exists (file, NULL));
+    files = g_list_prepend (files, g_object_ref (file));
+    result.file = file;
+
+    nautilus_file_operations_trash_with_result_async (files, NULL, NULL,
+                                                      trash_result_finished, &result);
+    g_assert_false (result.called);
+    g_main_loop_run (loop);
+    g_assert_true (result.called);
+    g_assert_true (result.success);
+    g_assert_cmpint (nautilus_file_undo_manager_get_state (), ==,
+                     NAUTILUS_FILE_UNDO_MANAGER_STATE_UNDO);
+    empty_directory_by_prefix (root, "trash_result");
+}
+
+static void
+test_trash_with_result_empty (void)
+{
+    g_autoptr (GMainLoop) loop = g_main_loop_new (NULL, FALSE);
+    TrashResult result = { .loop = loop };
+
+    nautilus_file_operations_trash_with_result_async (NULL, NULL, NULL,
+                                                      trash_result_finished, &result);
+    g_main_loop_run (loop);
+    g_assert_true (result.called);
+    g_assert_false (result.success);
+}
+
