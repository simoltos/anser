+/* SPDX-License-Identifier: GPL-3.0-or-later */
+#include "test-utilities.h"
+#include <nautilus-file-conflict-dialog.h>
+#include <nautilus-file-operations.h>
+#include <nautilus-file-undo-manager.h>
+#include <nautilus-file-utilities.h>
+#include <nautilus-global-preferences.h>
+#include <nautilus-image.h>
+#include <nautilus-resources.h>
+#include <nautilus-tag-manager.h>
+
+typedef struct
+{
+    GMainLoop *loop;
+    gboolean called;
+    gboolean success;
+    guint dialogs;
+} TransferResult;
+
+static void
+transfer_finished (gboolean success,
+                    gpointer user_data)
+{
+    TransferResult *result = user_data;
+    result->called = TRUE;
+    result->success = success;
+    g_main_loop_quit (result->loop);
+}
+
+static gboolean
+answer_conflicts (gpointer user_data)
+{
+    TransferResult *result = user_data;
+    GListModel *windows = gtk_window_get_toplevels ();
+
+    for (guint i = 0; i < g_list_model_get_n_items (windows); i++)
+    {
+        g_autoptr (GtkWindow) window = g_list_model_get_item (windows, i);
+        if (NAUTILUS_IS_FILE_CONFLICT_DIALOG (window) && gtk_widget_get_visible (GTK_WIDGET (window)))
+        {
+            /* Merge the outer and nested directories, then skip one child. */
+            const char *name = result->dialogs < 2 ? "replace_button" : "skip_button";
+            GObject *button = gtk_widget_get_template_child (GTK_WIDGET (window),
+                                                            NAUTILUS_TYPE_FILE_CONFLICT_DIALOG, name);
+            if (gtk_widget_get_sensitive (GTK_WIDGET (button)))
+            {
+                result->dialogs++;
+                g_signal_emit_by_name (button, "clicked");
+                break;
+            }
+        }
+    }
+    return G_SOURCE_CONTINUE;
+}
+
+static gboolean
+timed_out (gpointer user_data)
+{
+    g_error ("Transfer completion or conflict response did not finish");
+    return G_SOURCE_REMOVE;
+}
+
+static void
+test_completed_transfer (gconstpointer data)
+{
+    gboolean move = GPOINTER_TO_INT (data);
+    g_autoptr (GFile) source = g_file_new_build_filename (test_get_tmp_dir (), "result-source", NULL);
+    g_autoptr (GFile) target = g_file_new_build_filename (test_get_tmp_dir (), "result-target", NULL);
+    g_autoptr (GFile) destination = g_file_get_child (target, "result-source");
+    g_autoptr (GMainLoop) loop = g_main_loop_new (NULL, FALSE);
+    TransferResult result = { .loop = loop };
+
+    g_assert_true (g_file_replace_contents (source, "payload", 7, NULL, FALSE, 0, NULL, NULL, NULL));
+    g_assert_true (g_file_make_directory (target, NULL, NULL));
+    guint timeout = g_timeout_add_seconds (20, timed_out, NULL);
+    nautilus_file_operations_copy_move_with_result (&(GList){ .data = source }, target,
+                                                    move, NULL, transfer_finished, &result);
+    g_main_loop_run (loop);
+    g_source_remove (timeout);
+    g_assert_true (result.called);
+    g_assert_true (result.success);
+    g_assert_true (g_file_query_exists (destination, NULL));
+    g_assert_cmpint (g_file_query_exists (source, NULL), ==, !move);
+    test_clear_tmp_dir ();
+}
+
+static void
+test_merged_copy_skips_descendant (void)
+{
+    const GStrv hierarchy = (char *[]){
+        "result-source/", "result-source/bundle/", "result-source/bundle/nested/",
+        "result-source/bundle/nested/conflict.txt", "result-source/bundle/nested/copied.txt",
+        "result-target/", "result-target/bundle/", "result-target/bundle/nested/",
+        "result-target/bundle/nested/conflict.txt", NULL,
+    };
+    g_autoptr (GFile) source = g_file_new_build_filename (test_get_tmp_dir (), "result-source", "bundle", NULL);
+    g_autoptr (GFile) target = g_file_new_build_filename (test_get_tmp_dir (), "result-target", NULL);
+    g_autoptr (GFile) copied = g_file_get_child (target, "bundle/nested/copied.txt");
+    g_autoptr (GFile) original = g_file_get_child (source, "nested/conflict.txt");
+    g_autoptr (GFile) conflict = g_file_get_child (target, "bundle/nested/conflict.txt");
+    g_autoptr (GMainLoop) loop = g_main_loop_new (NULL, FALSE);
+    g_autofree char *contents = NULL;
+    TransferResult result = { .loop = loop };
+
+    file_hierarchy_create (hierarchy, "");
+    g_assert_true (g_file_replace_contents (conflict, "keep existing", 13, NULL, FALSE, 0, NULL, NULL, NULL));
+    guint answers = g_timeout_add (10, answer_conflicts, &result);
+    guint timeout = g_timeout_add_seconds (20, timed_out, NULL);
+    nautilus_file_operations_copy_move_with_result (&(GList){ .data = source }, target,
+                                                    FALSE, NULL, transfer_finished, &result);
+    g_main_loop_run (loop);
+    g_source_remove (answers);
+    g_source_remove (timeout);
+    g_assert_true (result.called);
+    g_assert_false (result.success);
+    g_assert_cmpuint (result.dialogs, ==, 3);
+    g_assert_true (g_file_query_exists (copied, NULL));
+    g_assert_true (g_file_query_exists (original, NULL));
+    g_assert_true (g_file_load_contents (conflict, NULL, &contents, NULL, NULL, NULL));
+    g_assert_cmpstr (contents, ==, "keep existing");
+    test_clear_tmp_dir ();
+}
+
+int
+main (int argc, char **argv)
+{
+    gtk_test_init (&argc, &argv, NULL);
+    adw_init ();
+    nautilus_register_resource ();
+    nautilus_global_preferences_init ();
+    // The conflict template contains NautilusImage; its class needs preferences.
+    g_type_ensure (NAUTILUS_TYPE_IMAGE);
+    test_init_config_dir ();
+    nautilus_ensure_extension_points ();
+    g_autoptr (NautilusFileUndoManager) undo_manager = nautilus_file_undo_manager_new ();
+    g_autoptr (NautilusTagManager) tag_manager = nautilus_tag_manager_new_dummy ();
+    g_test_add_data_func ("/transfer-result/copy-completed", GINT_TO_POINTER (FALSE), test_completed_transfer);
+    g_test_add_data_func ("/transfer-result/move-completed", GINT_TO_POINTER (TRUE), test_completed_transfer);
+    g_test_add_func ("/transfer-result/merged-copy-skipped-descendant", test_merged_copy_skips_descendant);
+    return g_test_run ();
+}
