+void
+nautilus_file_operations_copy_move_with_result (GList                          *files,
+                                                GFile                          *target_dir,
+                                                gboolean                        move,
+                                                NautilusFileOperationsDBusData *dbus_data,
+                                                NautilusOpCallback              callback,
+                                                gpointer                        callback_data)
+{
+    CopyMoveJob *job;
+    g_autoptr (GTask) task = NULL;
+
+    if (files == NULL || target_dir == NULL ||
+        g_file_has_uri_scheme (target_dir, SCHEME_STARRED) ||
+        g_file_has_uri_scheme (target_dir, SCHEME_BURN))
+    {
+        callback (FALSE, callback_data);
+        return;
+    }
+    if (move && g_file_has_uri_scheme (target_dir, SCHEME_TRASH))
+    {
+        nautilus_file_operations_trash_with_result_async (files, NULL, dbus_data,
+                                                          callback, callback_data);
+        return;
+    }
+    if (move)
+    {
+        job = move_job_setup (files, target_dir, NULL, dbus_data, NULL, NULL);
+    }
+    else
+    {
+        g_autoptr (GFile) source_dir = g_file_get_parent (files->data);
+        job = copy_job_setup (files, target_dir, NULL, dbus_data, NULL, NULL);
+        if (source_dir != NULL && g_file_equal (source_dir, target_dir))
+        {
+            g_clear_object (&job->destination);
+            if (!nautilus_file_undo_manager_is_operating ())
+            {
+                job->common.undo_info = nautilus_file_undo_info_ext_new (NAUTILUS_FILE_UNDO_OP_DUPLICATE,
+                                                                         g_list_length (files), source_dir, source_dir);
+            }
+        }
+    }
+    job->result_callback = callback;
+    job->result_callback_data = callback_data;
+    task = g_task_new (NULL, job->common.cancellable,
+                       move ? move_task_done : copy_task_done, job);
+    g_task_set_task_data (task, job, NULL);
+    g_task_run_in_thread (task, move ? nautilus_file_operations_move : nautilus_file_operations_copy);
 }

