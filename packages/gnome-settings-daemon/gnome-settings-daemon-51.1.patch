-        bytes = g_mapped_file_get_bytes (os_release);
-
-        id = get_os_release_variable (bytes, "ID");
-        version_id = get_os_release_variable (bytes, "VERSION_ID");
-
-        return g_strconcat (id, "-", version_id, NULL);
-}
