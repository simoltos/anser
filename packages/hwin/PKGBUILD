_commit=2e1041b240256c733481f3732b3b790a1b2203d9
pkgname=hwin
# The public Git history replaces the former private snapshot history.
epoch=2
pkgver=r8.g2e1041b24025
pkgrel=1
pkgdesc='HWin window manager and compositor with native tiling'
arch=('x86_64')
url='https://github.com/simoltos/honk'
groups=('honk')
